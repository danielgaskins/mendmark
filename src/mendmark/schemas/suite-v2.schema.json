{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mendmark.dev/schemas/suite-v2.schema.json",
  "title": "Mendmark agent execution suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases", "tools"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "policy": {"$ref": "suite-v1.schema.json#/$defs/policy"},
    "tools": {
      "type": "array",
      "items": {"$ref": "suite-v1.schema.json#/$defs/tool"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "role": {"type": ["string", "null"], "minLength": 1},
        "description": {"type": ["string", "null"], "minLength": 1},
        "allowed_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "kind", "actor_id"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["delegation", "message", "tool_call", "agent_result", "state_update"]
        },
        "actor_id": {"type": "string", "minLength": 1},
        "target_agent_id": {"type": ["string", "null"], "minLength": 1},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "tool_call": {"$ref": "suite-v1.schema.json#/$defs/call"},
        "payload": {}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "tool_call"}}, "required": ["kind"]},
          "then": {"required": ["tool_call"]},
          "else": {"not": {"required": ["tool_call"]}}
        },
        {
          "if": {"properties": {"kind": {"const": "delegation"}}, "required": ["kind"]},
          "then": {"required": ["target_agent_id"]}
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "input", "actual_output"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "input": {"type": "string"},
        "actual_output": {"type": "string"},
        "expected_output": {"type": ["string", "null"]},
        "tools_called": {
          "type": "array",
          "items": {"$ref": "suite-v1.schema.json#/$defs/call"}
        },
        "expected_tools": {
          "type": "array",
          "items": {"$ref": "suite-v1.schema.json#/$defs/call"}
        },
        "metadata": {"type": "object"},
        "tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "agents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/agent"}},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "expected_events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "root_agent_id": {"type": ["string", "null"], "minLength": 1}
      },
      "dependentRequired": {
        "events": ["agents", "root_agent_id"],
        "expected_events": ["agents", "root_agent_id"]
      }
    }
  }
}

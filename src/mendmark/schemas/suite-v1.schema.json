{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mendmark.dev/schemas/suite-v1.schema.json",
  "title": "Mendmark JSON suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases", "tools"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_kill_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "fail_on_critical_survivor": {"type": "boolean"},
        "fail_on_untested_tools": {"type": "boolean"},
        "fail_on_tool_contract_issues": {"type": "boolean"},
        "fail_on_regression": {"type": "boolean"}
      }
    },
    "tools": {
      "type": "array",
      "items": {"$ref": "#/$defs/tool"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_kill_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "fail_on_critical_survivor": {"type": "boolean"},
        "fail_on_untested_tools": {"type": "boolean"},
        "fail_on_tool_contract_issues": {"type": "boolean"},
        "fail_on_regression": {"type": "boolean"}
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "input_parameters": {"type": "object"},
        "output": {},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "input_schema": {"type": "object"},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
        "side_effecting": {"type": "boolean"}
      }
    },
    "outcomeRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline"],
      "properties": {
        "headline": {"type": "string", "minLength": 1, "maxLength": 512},
        "category": {"enum": ["financial", "operational", "compliance", "customer", "security", "reputation"]},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "estimated_loss_usd": {"type": ["number", "null"], "minimum": 0},
        "estimated_recovery_minutes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "outcomeInvariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "description", "path", "operator"],
      "properties": {
        "invariant_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "description": {"type": "string", "minLength": 1, "maxLength": 512},
        "path": {"type": "string", "pattern": "^/(?:[^~]|~[01])*(?:/(?:[^~]|~[01])*)*$", "minLength": 1, "maxLength": 512},
        "operator": {"enum": ["equals", "not_equals", "exists", "not_exists", "greater_than_or_equal", "less_than_or_equal", "contains"]},
        "expected": {},
        "severity": {"enum": ["low", "medium", "high", "critical"]}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "actual_state", "expected_state"],
      "properties": {
        "objective": {"type": "string", "minLength": 1, "maxLength": 512},
        "actual_state": {"type": "object"},
        "expected_state": {"type": "object"},
        "invariants": {"type": "array", "items": {"$ref": "#/$defs/outcomeInvariant"}},
        "risk": {"anyOf": [{"$ref": "#/$defs/outcomeRisk"}, {"type": "null"}]},
        "actual_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "maximum_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "actual_duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "maximum_duration_ms": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "input", "actual_output"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "input": {"type": "string"},
        "actual_output": {"type": "string"},
        "expected_output": {"type": ["string", "null"]},
        "tools_called": {"type": "array", "items": {"$ref": "#/$defs/call"}},
        "expected_tools": {"type": "array", "items": {"$ref": "#/$defs/call"}},
        "metadata": {"type": "object"},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "outcome": {"$ref": "#/$defs/outcome"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mendmark.dev/schemas/evaluator-response-v2.schema.json",
  "title": "Mendmark multi-agent evaluator response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluations"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evaluation_id", "results"],
        "properties": {
          "evaluation_id": {"type": "string", "minLength": 1},
          "results": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "evaluator-response-v1.schema.json#/$defs/result"}
          }
        }
      }
    }
  }
}

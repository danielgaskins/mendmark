{
  "schema_version": "1.0",
  "policy": {
    "minimum_kill_rate": 1.0,
    "fail_on_critical_survivor": true,
    "fail_on_untested_tools": true,
    "fail_on_tool_contract_issues": true,
    "fail_on_regression": true
  },
  "tools": [
    {
      "name": "catalog_search",
      "description": "Search the product catalog",
      "input_schema": {"type": "object", "properties": {"query": {"type": "string"}, "limit": {"type": "integer"}}, "required": ["query", "limit"]},
      "side_effecting": false
    },
    {
      "name": "get_customer",
      "description": "Fetch a customer record",
      "input_schema": {"type": "object", "properties": {"customer_id": {"type": "string"}}, "required": ["customer_id"]},
      "side_effecting": false
    },
    {
      "name": "lookup_order",
      "description": "Fetch an order record",
      "input_schema": {"type": "object", "properties": {"order_id": {"type": "string"}}, "required": ["order_id"]},
      "side_effecting": false
    },
    {
      "name": "refund_order",
      "description": "Issue a refund for a verified order",
      "input_schema": {"type": "object", "properties": {"order_id": {"type": "string"}, "amount": {"type": "number"}, "reason": {"type": "string"}}, "required": ["order_id", "amount", "reason"]},
      "side_effecting": true
    },
    {
      "name": "charge_card",
      "description": "Charge a customer's saved payment method",
      "input_schema": {"type": "object", "properties": {"customer_id": {"type": "string"}, "amount": {"type": "number"}, "capture": {"type": "boolean"}}, "required": ["customer_id", "amount", "capture"]},
      "side_effecting": true
    },
    {
      "name": "send_email",
      "description": "Send a templated email",
      "input_schema": {"type": "object", "properties": {"to": {"type": "string"}, "template": {"type": "string"}, "variables": {"type": "object"}}, "required": ["to", "template", "variables"]},
      "side_effecting": true
    },
    {
      "name": "read_record",
      "description": "Read one database record",
      "input_schema": {"type": "object", "properties": {"table": {"type": "string"}, "key": {"type": "string"}}, "required": ["table", "key"]},
      "side_effecting": false
    },
    {
      "name": "write_record",
      "description": "Write one database record",
      "input_schema": {"type": "object", "properties": {"table": {"type": "string"}, "key": {"type": "string"}, "value": {"type": "object"}}, "required": ["table", "key", "value"]},
      "side_effecting": true
    },
    {
      "name": "schedule_job",
      "description": "Schedule a background job",
      "input_schema": {"type": "object", "properties": {"job": {"type": "string"}, "run_at": {"type": "string"}, "options": {"type": "object"}}, "required": ["job", "run_at", "options"]},
      "side_effecting": true
    },
    {
      "name": "cancel_job",
      "description": "Cancel a scheduled job",
      "input_schema": {"type": "object", "properties": {"job_id": {"type": "string"}}, "required": ["job_id"]},
      "side_effecting": true
    },
    {
      "name": "get_weather",
      "description": "Fetch a weather forecast",
      "input_schema": {"type": "object", "properties": {"city": {"type": "string"}, "units": {"type": "string"}}, "required": ["city", "units"]},
      "side_effecting": false
    },
    {
      "name": "create_ticket",
      "description": "Create a support ticket",
      "input_schema": {"type": "object", "properties": {"title": {"type": "string"}, "priority": {"type": "integer"}, "tags": {"type": "array"}}, "required": ["title", "priority", "tags"]},
      "side_effecting": true
    },
    {
      "name": "update_ticket",
      "description": "Update a support ticket",
      "input_schema": {"type": "object", "properties": {"ticket_id": {"type": "string"}, "status": {"type": "string"}, "notify": {"type": "boolean"}}, "required": ["ticket_id", "status", "notify"]},
      "side_effecting": true
    }
  ],
